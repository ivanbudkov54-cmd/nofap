rules_version = '2';

// Правила доступа для напарника. Вставляются в Firebase Console →
// Firestore Database → Rules. Схема данных — в FirebasePartnerSync.swift.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Профиль: писать — только в свой. Читать можно по точному uid
    // (списком — нельзя). uid случайный и узнаётся только через пару;
    // при разрыве связи аккаунт пересоздаётся, и старый uid умирает.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['nickname', 'currentStreak', 'goalDays', 'lastCheckInDay', 'updatedAt', 'partnerId'])
        && (!('nickname' in request.resource.data)
            || (request.resource.data.nickname is string
                && request.resource.data.nickname.size() <= 32));
    }

    // Приглашение: прочитать можно, только зная код; перебрать списком
    // нельзя. Принять — один раз, до истечения, и только вписав себя.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.acceptedBy == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly(['ownerId', 'acceptedBy', 'expiresAt']);
      allow update: if signedIn()
        && resource.data.acceptedBy == null
        && resource.data.ownerId != request.auth.uid
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy'])
        && request.resource.data.acceptedBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Переписка пары. Имя пары — два uid через «_», поэтому участие
    // проверяется без лишних чтений.
    match /pairs/{pairId}/messages/{messageId} {
      function member() {
        return signedIn() && request.auth.uid in pairId.split('_');
      }
      allow read: if member();
      allow delete: if member();
      allow create: if member()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.kind in ['text', 'sos', 'support']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.sentAt == request.time
        && request.resource.data.keys().hasOnly(['senderId', 'kind', 'text', 'sentAt']);
    }
  }
}
