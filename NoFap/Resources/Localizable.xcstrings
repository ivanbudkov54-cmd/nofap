        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Through doubt and crisis. The mind is winning over the flesh."
          }
        }
      }
    },
    "Полководец своей жизни. Высокий уровень тестостерона и фокуса.": {
      "localizations": {
