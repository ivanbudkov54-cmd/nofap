    "Настоящие отношения": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real relationships"
          }
        }
      }
    },
    "Настройки защиты, напоминания и удаление данных.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection settings, reminders and data deletion."
          }
        }
      }
    },
    "Начни с %lld дней — не потому что это правильный срок, а потому что его реально пройти. Дальше поднимешь сам.": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Начни с %lld дня — не потому что это правильный срок, а потому что его реально пройти. Дальше поднимешь сам."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Начни с %lld дней — не потому что это правильный срок, а потому что его реально пройти. Дальше поднимешь сам."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Начни с %lld дней — не потому что это правильный срок, а потому что его реально пройти. Дальше поднимешь сам."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Начни с %lld дней — не потому что это правильный срок, а потому что его реально пройти. Дальше поднимешь сам."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Start with %lld day — not because it's the right number, but because it's one you can actually reach. You'll raise it yourself later."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Start with %lld days — not because it's the right number, but because it's one you can actually reach. You'll raise it yourself later."
                }
              }
            }
          }
        }
