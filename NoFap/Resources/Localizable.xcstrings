    "Сбить острую тягу и вернуть физическую силу.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбить острую тягу и вернуть физическую силу."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knock down the acute urge and get your physical strength back."
          }
        }
      }
    },
    "Вернуть ясность ума и контроль над вниманием.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть ясность ума и контроль над вниманием."
