          }
        }
      }
    },
    "Прошел через сомнения и кризис. Разум побеждает плоть.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошел через сомнения и кризис. Разум побеждает плоть."
