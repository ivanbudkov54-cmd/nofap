          }
        }
      }
    },
    "Крепкий щит и поставленный удар. Контроль базовых триггеров.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крепкий щит и поставленный удар. Контроль базовых триггеров."
