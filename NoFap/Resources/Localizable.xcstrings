      }
    },
    "Например: после смены, когда все уснули": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: after a shift, once everyone's asleep"
          }
        }
      }
    },
    "Например: хочу высыпаться": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: I want to sleep well"
