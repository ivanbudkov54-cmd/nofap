            "value": "Miyamoto Musashi"
          }
        }
      }
    },
    "Мухаммед Али": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мухаммед Али"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muhammad Ali"
          }
        }
      }
    },
    "Уинстон Черчилль": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уинстон Черчилль"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winston Churchill"
          }
        }
      }
    },
    "Платон": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платон"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plato"
          }
        }
      }
    },
    "Никто не придет тебя спасать. Нет никакой волшебной кнопки. Есть только ты, твоя слабость и зеркало напротив.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не придет тебя спасать. Нет никакой волшебной кнопки. Есть только ты, твоя слабость и зеркало напротив."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one is coming to save you. There is no magic button. There is only you, your weakness, and the mirror in front of you."
          }
        }
      }
    },
    "Дисциплина — это делать то, что ты ненавидишь всем нутром, но делать это так, будто ты в этом лучший.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисциплина — это делать то, что ты ненавидишь всем нутром, но делать это так, будто ты в этом лучший."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discipline is doing what you hate with your whole being, and doing it as if you were the best at it."
          }
        }
      }
    },
    "У тебя есть власть над своим разумом, а не над внешними соблазнами. Осознай это — и ты обретешь непоколебимую силу.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У тебя есть власть над своим разумом, а не над внешними соблазнами. Осознай это — и ты обретешь непоколебимую силу."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have power over your mind — not outside events. Realize this, and you will find strength."
          }
        }
      }
    },
    "Какое бесчестие для мужчины — состариться, так и не узнав, на какую силу, выносливость и красоту способно его тело.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое бесчестие для мужчины — состариться, так и не узнав, на какую силу, выносливость и красоту способно его тело."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a shame for a man to grow old without seeing the strength, endurance, and beauty of which his body is capable."
          }
        }
      }
    },
    "Самый могущественный человек на земле — это тот, кто сумел подчинить самого себя.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый могущественный человек на земле — это тот, кто сумел подчинить самого себя."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most powerful is he who has himself in his own power."
          }
        }
      }
    },
    "Когда твой мозг шепчет, что ты истощен и пора сдаться, — ты израсходовал всего 40% своего истинного запаса прочности.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда твой мозг шепчет, что ты истощен и пора сдаться, — ты израсходовал всего 40% своего истинного запаса прочности."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your mind is telling you that you're done, you're really only 40 percent done."
          }
        }
      }
    },
    "Сегодня я одержу победу над собой вчерашним; завтра я одержу победу над своей главной слабостью.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня я одержу победу над собой вчерашним; завтра я одержу победу над своей главной слабостью."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today I will defeat the self of yesterday; tomorrow I will defeat my greatest weakness."
          }
        }
      }
    },
    "Не сдавайся сейчас. Потерпи дискомфорт сегодня — и проживи остаток жизни хозяином своей судьбы.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сдавайся сейчас. Потерпи дискомфорт сегодня — и проживи остаток жизни хозяином своей судьбы."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't quit now. Endure the discomfort today, and live the rest of your life as the master of your fate."
          }
        }
      }
    },
    "Победа — это не финал, срыв — это не приговор. Значение имеет только мужество продолжать путь.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Победа — это не финал, срыв — это не приговор. Значение имеет только мужество продолжать путь."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Success is not final, failure is not fatal: it is the courage to continue that counts."
          }
        }
      }
    },
    "Первая и лучшая победа — это победа над своими желаниями. Капитулировать перед ними — самый горький из всех уделов.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая и лучшая победа — это победа над своими желаниями. Капитулировать перед ними — самый горький из всех уделов."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first and best victory is to conquer yourself. To be conquered by yourself is of all things the most shameful."
          }
        }
      }
    },
    "Физический сброс": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Физический сброс"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Physical reset"
          }
        }
      }
    },
    "Выбери нагрузку и доведи её до конца. Импульс не переживёт жжение в мышцах.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери нагрузку и доведи её до конца. Импульс не переживёт жжение в мышцах."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a drill and finish it. The urge will not survive the burn."
          }
        }
      }
    },
    "Взрывные отжимания": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взрывные отжимания"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explosive push-ups"
          }
        }
      }
    },
    "До отказа": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До отказа"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To failure"
          }
        }
      }
    },
    "Перенаправление кровотока в верхний плечевой пояс": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенаправление кровотока в верхний плечевой пояс"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirect blood flow into the shoulders and chest"
          }
        }
      }
    },
    "Прими упор лёжа с идеальной прямой спиной.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прими упор лёжа с идеальной прямой спиной."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get into a push-up with a perfectly straight back."
          }
        }
      }
    },
    "Выполняй отжимания в максимальном темпе без пауз.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняй отжимания в максимальном темпе без пауз."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do push-ups at full speed, without pauses."
          }
        }
      }
    },
    "В последнем повторении замри в нижней точке на 5 секунд.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В последнем повторении замри в нижней точке на 5 секунд."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the last rep, hold the bottom position for 5 seconds."
          }
        }
      }
    },
    "Срочно перенаправляет кровь из тазовой зоны в грудь и плечи. Выброс молочной кислоты выбивает мозг из сексуального транса.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срочно перенаправляет кровь из тазовой зоны в грудь и плечи. Выброс молочной кислоты выбивает мозг из сексуального транса."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It pulls blood out of the pelvis and into the chest and shoulders. The burn of lactic acid knocks the mind out of a sexual trance."
          }
        }
      }
    },
    "«Стульчик» у стены": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Стульчик» у стены"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall sit"
          }
        }
      }
    },
    "60 секунд": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60 секунд"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 seconds"
          }
        }
      }
    },
    "Статическое жжение в квадрицепсах": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статическое жжение в квадрицепсах"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A static burn in the quads"
          }
        }
      }
    },
    "Прижмись спиной к стене и опустись до угла 90° в коленях.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прижмись спиной к стене и опустись до угла 90° в коленях."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press your back to the wall and sink until your knees are at 90°."
          }
        }
      }
    },
    "Руки вытяни перед собой, не клади их на ноги.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Руки вытяни перед собой, не клади их на ноги."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach your arms forward. Do not rest them on your legs."
          }
        }
      }
    },
    "Держи позицию через жжение, пока таймер не завершится.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи позицию через жжение, пока таймер не завершится."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold through the burn until the timer ends."
          }
        }
      }
    },
    "Изометрическое напряжение крупнейших мышц ног заставляет префронтальную кору фокусироваться на удержании позы, гася компульсивный импульс.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изометрическое напряжение крупнейших мышц ног заставляет префронтальную кору фокусироваться на удержании позы, гася компульсивный импульс."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isometric tension in the biggest leg muscles forces the prefrontal cortex to hold the pose, and the compulsive urge fades."
          }
        }
      }
    },
    "Бёрпи на скорость": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бёрпи на скорость"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed burpees"
          }
        }
      }
    },
    "20 повторений": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "20 повторений"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20 reps"
          }
        }
      }
    },
    "Резкий разгон пульса до анаэробной зоны": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резкий разгон пульса до анаэробной зоны"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sharp spike of the heart rate into the anaerobic zone"
          }
        }
      }
    },
    "Упор присев -> прыжком в упор лёжа -> коснись пола грудью.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упор присев -> прыжком в упор лёжа -> коснись пола грудью."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat down, jump to a plank, and touch the floor with your chest."
          }
        }
      }
    },
    "Взрывным движением вернись в присед и выпрыгни вверх с хлопком.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взрывным движением вернись в присед и выпрыгни вверх с хлопком."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explode back to a squat and jump up with a clap."
          }
        }
      }
    },
    "Делай без пауз на отдых.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делай без пауз на отдых."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not pause to rest."
          }
        }
      }
    },
    "Поднимает пульс до 140+ уд/мин. Активирует режим «бей или беги», в котором размножение биологически блокируется организмом.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимает пульс до 140+ уд/мин. Активирует режим «бей или беги», в котором размножение биологически блокируется организмом."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It drives the heart rate past 140 bpm and switches on fight-or-flight, where the body biologically shuts down mating."
          }
        }
      }
    },
    "Планка с коленями к локтям": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планка с коленями к локтям"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plank with knees to elbows"
          }
        }
      }
    },
    "Жесткая фиксация мышечного корсета": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесткая фиксация мышечного корсета"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard lock of the core"
          }
        }
      }
    },
    "Встань в планку на предплечьях, напряги пресс и ягодицы.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встань в планку на предплечьях, напряги пресс и ягодицы."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a forearm plank and brace your abs and glutes."
          }
        }
      }
    },
    "Поочередно медленно подтягивай колено к локтю с фиксацией на 2 секунды.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поочередно медленно подтягивай колено к локтю с фиксацией на 2 секунды."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly draw each knee to the elbow and hold for 2 seconds."
          }
        }
      }
    },
    "Не задирай и не проваливай таз.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не задирай и не проваливай таз."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not pike or sag the hips."
          }
        }
      }
    },
    "Разгружает пояснично-крестцовый отдел и включает глубокие стабилизаторы кора, убирая физический застой.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разгружает пояснично-крестцовый отдел и включает глубокие стабилизаторы кора, убирая физический застой."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It unloads the lower back and switches on the deep core stabilizers, clearing physical stagnation."
          }
        }
      }
    },
    "Приседания с выпрыгиванием": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приседания с выпрыгиванием"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump squats"
          }
        }
      }
    },
    "25 повторений": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "25 повторений"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "25 reps"
          }
        }
      }
    },
    "Взрывная нагрузка на нижний этаж тела": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взрывная нагрузка на нижний этаж тела"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explosive work for the lower body"
          }
        }
      }
    },
    "Опустись в глубокий присед ниже параллели.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опустись в глубокий присед ниже параллели."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop into a deep squat below parallel."
          }
        }
      }
    },
    "Резко и мощно выпрыгни максимально высоко.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резко и мощно выпрыгни максимально высоко."
